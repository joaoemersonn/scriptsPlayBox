# Exemplo de arquivo .env para este projeto
# Copie este arquivo para `.env` e preencha com os valores reais.

# VendProMax (credenciais de login)
VENDPROMAX_EMAIL=seu-email@exemplo.com
VENDPROMAX_PASSWORD=sua_senha_segura

# PayXYZ (credenciais de login)
PAYXYZ_EMAIL=seu-email@exemplo.com
PAYXYZ_PASSWORD=sua_senha_segura

# Zapizi (credenciais e organização)
ZAPIZI_EMAIL=seu_usuario_zapizi
ZAPIZI_PASSWORD=sua_senha_segura
ZAPIZI_ORGANIZATION_ID=0000

# GreenAPI (WhatsApp)
# `GREENAPI_SEND_PATH` é a parte do endpoint retornada pela GreenAPI (p.ex. sendMessage/<token>)
GREENAPI_SEND_PATH=sendMessage/SEU_TOKEN_AQUI
GREENAPI_CHAT_ID=5521999999999@g.us

# Observação: este arquivo NÃO deve conter valores reais em commits públicos.