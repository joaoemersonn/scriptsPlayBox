# Exemplo de arquivo .env para este projeto
# Copie este arquivo para `.env` e preencha com os valores reais.

# VendProMax (credenciais de login)
VENDPROMAX_EMAIL=seu-email@exemplo.com
VENDPROMAX_PASSWORD=sua_senha_segura

# PayXYZ (credenciais de login)
PAYXYZ_EMAIL=seu-email@exemplo.com
PAYXYZ_PASSWORD=sua_senha_segura

# Zapizi (credenciais e organização)
ZAPIZI_EMAIL=seu_usuario_zapizi
ZAPIZI_PASSWORD=sua_senha_segura
ZAPIZI_ORGANIZATION_ID=0000

# WhatsApp Bot (BotWhatsApp Baileys REST)
WHATSAPP_HOST=whatsapp-bot
WHATSAPP_PORT=3035
WHATSAPP_BASE_URL=http://whatsapp-bot:3035
WHATSAPP_API_KEY=sua_chave_de_api
WHATSAPP_SEND_PATH=/api/messages/send
WHATSAPP_MONITOR_CHAT_ID=120363430600021348@g.us
WHATSAPP_REPORT_CHAT_ID=120363411732539594@g.us

# Chave de API para autenticação nos métodos da aplicação (Swagger / API REST)
APP_API_KEY=sua_chave_secreta_api

# Autenticação de Acesso ao Painel Web
AUTH_USERNAME=admin
AUTH_PASSWORD=PlayBox@2026!

# Ngrok (Túnel com Domínio Estático Gratuito)
# 1. Obtenha seu authtoken gratuito em https://dashboard.ngrok.com/get-started/your-authtoken
# 2. Reivindique seu domínio estático gratuito em https://dashboard.ngrok.com/domains (ex: playbox-ops.ngrok-free.app)
NGROK_AUTHTOKEN=seu_ngrok_authtoken_aqui
NGROK_DOMAIN=seu-dominio-estatico.ngrok-free.app